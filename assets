/* ═══════════════════════════════════════════════════════════
   Phoenix Arabia — Master Stylesheet
   Brand: Phoenix Blue #1E3A8A · Phoenix Green #0B7A3B
═══════════════════════════════════════════════════════════ */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  /* Phoenix Brand Colors */
  --pa-blue: #1E3A8A;
  --pa-blue-dark: #152960;
  --pa-blue-light: #3151A8;
  --pa-blue-soft: #E8EDF8;
  --pa-blue-bg: #F4F7FC;

  --pa-green: #0B7A3B;
  --pa-green-dark: #075828;
  --pa-green-light: #128B47;
  --pa-green-soft: #E5F1EB;
  --pa-green-border: #B8DBC4;

  --pa-black: #111111;
  --pa-charcoal: #1F2937;
  --pa-slate: #4B5563;
  --pa-muted: #6B7280;
  --pa-border: #E5E7EB;
  --pa-border-soft: #F3F4F6;
  --pa-bg: #FAFBFC;
  --pa-off: #F4F7FA;
  --pa-light: #E8EEF4;
  --pa-white: #FFFFFF;

  --shadow-sm: 0 1px 2px rgba(17,24,39,0.04);
  --shadow-md: 0 4px 12px rgba(30,58,138,0.08);
  --shadow-lg: 0 10px 32px rgba(30,58,138,0.12);

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 20px;

  --container: 1280px;
}

html { scroll-behavior: smooth; }

body {
  background: var(--pa-bg);
  color: var(--pa-black);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--pa-blue); text-decoration: none; transition: color 0.2s; }
a:hover { color: var(--pa-blue-dark); }

img { max-width: 100%; height: auto; display: block; }

.container { max-width: var(--container); margin: 0 auto; padding: 0 24px; }

/* ── TOPBAR ── */
.topbar {
  background: var(--pa-charcoal);
  color: rgba(255,255,255,0.85);
  font-size: 12px;
  padding: 8px 0;
}
.topbar .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
.topbar a { color: rgba(255,255,255,0.85); }
.topbar a:hover { color: white; }

/* ── NAV ── */
.nav {
  background: var(--pa-white);
  border-bottom: 3px solid transparent;
  border-image: linear-gradient(90deg, var(--pa-blue) 60%, var(--pa-green) 100%) 1;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}
.nav .container {
  display: flex;
  align-items: center;
  gap: 16px;
  height: 72px;
}
.brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.brand .mark { display: flex; flex-direction: column; gap: 3px; }
.brand .mark .b { width: 40px; height: 4px; background: var(--pa-blue); border-radius: 1px; display: block; }
.brand .mark .g { width: 28px; height: 4px; background: var(--pa-green); border-radius: 1px; display: block; }
.brand h1 { font-size: 18px; font-weight: 800; color: var(--pa-blue); letter-spacing: -0.3px; line-height: 1; }
.brand p { font-size: 10px; color: var(--pa-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; font-weight: 600; }

.nav .links {
  display: flex;
  gap: 4px;
  margin-left: auto;
  align-items: center;
}
.nav .links a {
  color: var(--pa-charcoal);
  font-size: 14px;
  font-weight: 500;
  padding: 8px 14px;
  border-radius: var(--radius-md);
  transition: all 0.2s;
}
.nav .links a:hover { color: var(--pa-blue); background: var(--pa-blue-soft); }

/* ── BUTTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 18px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  border: 0;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.2s;
  white-space: nowrap;
  line-height: 1.2;
}
.btn.blue { background: var(--pa-blue); color: white; }
.btn.blue:hover { background: var(--pa-blue-dark); color: white; }
.btn.green { background: var(--pa-green); color: white; }
.btn.green:hover { background: var(--pa-green-dark); color: white; }
.btn.dark { background: var(--pa-charcoal); color: white; }
.btn.dark:hover { background: var(--pa-black); color: white; }
.btn.light { background: var(--pa-white); color: var(--pa-charcoal); border: 1px solid var(--pa-border); }
.btn.light:hover { background: var(--pa-off); }
.btn.outline { background: transparent; color: var(--pa-blue); border: 1.5px solid var(--pa-blue); }
.btn.outline:hover { background: var(--pa-blue); color: white; }

/* ── HERO ── */
.hero {
  background: linear-gradient(135deg, var(--pa-blue) 0%, var(--pa-blue-dark) 100%);
  color: white;
  padding: 70px 0 90px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 20% 80%, rgba(11,122,59,0.18) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.06) 0%, transparent 50%);
  pointer-events: none;
}
.hero .container { position: relative; z-index: 1; }
.hero-wrap {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 48px;
}
.kicker {
  display: inline-block;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 6px 14px;
  border-radius: 30px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.95);
  margin-bottom: 18px;
}
.hero h2 {
  font-size: 48px;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -1px;
  margin-bottom: 18px;
}
.hero h2 span { color: #6EDB95; }
.hero p { font-size: 17px; line-height: 1.65; color: rgba(255,255,255,0.85); max-width: 560px; margin-bottom: 28px; }

.hero-card {
  background: white;
  border-radius: var(--radius-xl);
  padding: 28px;
  color: var(--pa-black);
  box-shadow: var(--shadow-lg);
}
.hero-card h3 {
  font-size: 18px;
  font-weight: 800;
  color: var(--pa-blue);
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--pa-blue-soft);
}
.hero-card ul { list-style: none; padding: 0; }
.hero-card li {
  font-size: 13px;
  color: var(--pa-charcoal);
  padding: 8px 0 8px 22px;
  position: relative;
  line-height: 1.5;
  border-bottom: 1px solid var(--pa-border-soft);
}
.hero-card li:last-child { border-bottom: 0; }
.hero-card li::before {
  content: '✓';
  color: var(--pa-green);
  font-weight: 900;
  position: absolute;
  left: 0;
  top: 8px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  position: relative;
  z-index: 1;
}
.stat {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  text-align: center;
}
.stat b {
  display: block;
  font-size: 20px;
  font-weight: 800;
  color: white;
  margin-bottom: 4px;
  letter-spacing: 0.5px;
}
.stat span { font-size: 11px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.5px; }

@media (max-width: 1024px) {
  .hero-wrap { grid-template-columns: 1fr; gap: 32px; }
  .hero h2 { font-size: 36px; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}

/* ── SECTION ── */
.section {
  padding: 80px 0;
  background: white;
}
.section.dark-section {
  background: var(--pa-charcoal);
  color: white;
}
.section.dark-section h2,
.section.dark-section h3,
.section.dark-section .head h2 { color: white; }
.section.dark-section p { color: rgba(255,255,255,0.7); }
.section.dark-section .card { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1); color: white; }
.section.dark-section .card h3 { color: white; }
.section.dark-section .card p { color: rgba(255,255,255,0.7); }

.section.protection { background: var(--pa-bg); }

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 36px;
}
.head h2 {
  font-size: 32px;
  font-weight: 800;
  color: var(--pa-black);
  line-height: 1.2;
  letter-spacing: -0.5px;
  margin-bottom: 8px;
}
.head p { font-size: 15px; color: var(--pa-slate); max-width: 640px; line-height: 1.6; }

/* ── MARKETBAR (Search/Filter) ── */
.marketbar {
  background: white;
  border: 1px solid var(--pa-border);
  border-radius: var(--radius-lg);
  padding: 12px 16px;
  display: grid;
  grid-template-columns: 1fr 200px 200px;
  gap: 12px;
  margin-bottom: 24px;
  box-shadow: var(--shadow-sm);
}
.search, .select, .input {
  border: 1.5px solid var(--pa-border);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-size: 14px;
  font-family: inherit;
  background: var(--pa-off);
  color: var(--pa-charcoal);
  outline: none;
  width: 100%;
  transition: all 0.2s;
}
.search:focus, .select:focus, .input:focus, .textarea:focus { border-color: var(--pa-blue); background: white; }
.textarea {
  border: 1.5px solid var(--pa-border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  font-size: 14px;
  font-family: inherit;
  background: var(--pa-off);
  color: var(--pa-charcoal);
  outline: none;
  width: 100%;
  resize: vertical;
  min-height: 100px;
  transition: all 0.2s;
}
.file {
  border: 1.5px dashed var(--pa-border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  font-size: 13px;
  font-family: inherit;
  background: var(--pa-off);
  color: var(--pa-muted);
  width: 100%;
}

@media (max-width: 768px) {
  .marketbar { grid-template-columns: 1fr; }
}

/* ── PRODUCTS GRID ── */
.products {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
  margin-top: 24px;
}
.product {
  background: white;
  border: 1px solid var(--pa-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
}
.product:hover { border-color: var(--pa-blue); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.pimg {
  height: 160px;
  background: var(--pa-off);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid var(--pa-border);
  padding: 16px;
}
.pimg img { max-height: 100%; max-width: 100%; object-fit: contain; }
.pbody { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; }
.tag {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--pa-blue);
  font-weight: 700;
  margin-bottom: 6px;
}
.pbody h3 {
  font-size: 14px;
  font-weight: 700;
  color: var(--pa-black);
  margin-bottom: 6px;
  line-height: 1.4;
}
.pbody h3 a { color: var(--pa-black); }
.pbody h3 a:hover { color: var(--pa-blue); }
.pbody p { font-size: 12px; color: var(--pa-muted); margin-bottom: 10px; line-height: 1.55; flex: 1; }
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
  font-size: 10px;
}
.meta span {
  background: var(--pa-blue-soft);
  color: var(--pa-blue);
  padding: 2px 8px;
  border-radius: 12px;
  font-weight: 600;
}
.pfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10px;
  border-top: 1px solid var(--pa-border-soft);
  gap: 8px;
}
.price {
  font-size: 15px;
  font-weight: 800;
  color: var(--pa-blue);
}
.request {
  font-size: 11px;
  color: var(--pa-green-dark);
  background: var(--pa-green-soft);
  padding: 4px 10px;
  border-radius: 12px;
  font-weight: 700;
  border: 1px solid var(--pa-green-border);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

/* ── CARDS GRIDS ── */
.grid3, .grid4 {
  display: grid;
  gap: 20px;
}
.grid3 { grid-template-columns: repeat(3, 1fr); }
.grid4 { grid-template-columns: repeat(4, 1fr); }

.card {
  background: white;
  border: 1px solid var(--pa-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  transition: all 0.2s;
}
.card:hover { border-color: var(--pa-blue); box-shadow: var(--shadow-md); transform: translateY(-2px); }
.card h3 {
  font-size: 17px;
  font-weight: 700;
  color: var(--pa-black);
  margin-bottom: 8px;
  line-height: 1.3;
}
.card h3 a { color: var(--pa-black); }
.card h3 a:hover { color: var(--pa-blue); }
.card p { font-size: 13px; color: var(--pa-slate); line-height: 1.6; }
.card .icon { font-size: 32px; margin-bottom: 10px; }

.pill {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--pa-blue);
  background: var(--pa-blue-soft);
  padding: 4px 10px;
  border-radius: 12px;
  margin-bottom: 8px;
}

@media (max-width: 1024px) {
  .grid3 { grid-template-columns: repeat(2, 1fr); }
  .grid4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .grid3, .grid4 { grid-template-columns: 1fr; }
}

/* ── RFQ-CART CONCEPT BOX ── */
.rfq-cart {
  background: linear-gradient(135deg, var(--pa-green) 0%, var(--pa-green-dark) 100%);
  color: white;
  padding: 28px 32px;
  border-radius: var(--radius-lg);
  margin-top: 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}
.rfq-cart h3 { font-size: 20px; font-weight: 800; margin-bottom: 6px; color: white; }
.rfq-cart p { color: rgba(255,255,255,0.9); font-size: 14px; max-width: 560px; line-height: 1.5; }
.rfq-cart .btn { background: white; color: var(--pa-green-dark); }
.rfq-cart .btn:hover { background: var(--pa-bg); color: var(--pa-green-dark); }

/* ── RFQ BAND ── */
.rfq-band {
  background: white;
  border: 1px solid var(--pa-border);
  border-radius: var(--radius-lg);
  padding: 32px;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 32px;
  align-items: start;
  box-shadow: var(--shadow-md);
}
.rfq-band h2 { font-size: 24px; font-weight: 800; color: var(--pa-black); margin-bottom: 12px; line-height: 1.2; }
.rfq-band p { color: var(--pa-slate); font-size: 14px; line-height: 1.6; }
.rfq-form { display: flex; flex-direction: column; gap: 12px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 768px) {
  .rfq-band { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
}

/* ── SUPPLIER CTA ── */
.supplier-cta {
  background: linear-gradient(135deg, var(--pa-blue) 0%, var(--pa-blue-dark) 100%);
  color: white;
  padding: 36px;
  border-radius: var(--radius-lg);
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 36px;
  align-items: center;
}
.supplier-cta h2 { font-size: 24px; font-weight: 800; margin-bottom: 12px; color: white; }
.supplier-cta p { color: rgba(255,255,255,0.85); font-size: 14px; line-height: 1.6; }
.supplier-cta .notice {
  background: rgba(255,255,255,0.1);
  border-left: 3px solid #6EDB95;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  margin-top: 14px;
  font-size: 12px;
  color: rgba(255,255,255,0.9);
}
@media (max-width: 1024px) { .supplier-cta { grid-template-columns: 1fr; } }

/* ── ARTICLE PAGE ── */
.article {
  max-width: 760px;
  margin: 0 auto;
  background: white;
  border: 1px solid var(--pa-border);
  border-radius: var(--radius-lg);
  padding: 48px;
}
.article h1 {
  font-size: 32px;
  font-weight: 800;
  color: var(--pa-black);
  margin: 12px 0 16px;
  line-height: 1.2;
}
.article hr { border: 0; border-top: 1px solid var(--pa-border); margin: 24px 0; }
.article p { color: var(--pa-charcoal); line-height: 1.8; font-size: 15px; }
@media (max-width: 768px) { .article { padding: 24px; } }

/* ── FOOTER ── */
.footer {
  background: var(--pa-charcoal);
  color: rgba(255,255,255,0.7);
  padding: 60px 0 24px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 36px;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 24px;
}
.footer h3 {
  font-size: 18px;
  font-weight: 800;
  color: white;
  margin-bottom: 12px;
}
.footer h4 {
  font-size: 13px;
  font-weight: 700;
  color: white;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 14px;
}
.footer a {
  display: block;
  color: rgba(255,255,255,0.6);
  font-size: 13px;
  padding: 4px 0;
  transition: color 0.2s;
}
.footer a:hover { color: white; }
.footer p { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 12px; }
.employee-link { margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); }
.employee-link a { color: rgba(255,255,255,0.4); font-size: 11px; }
.employee-link a:hover { color: white; }

.footer-credentials {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 11px;
  color: rgba(255,255,255,0.5);
  padding-top: 16px;
}
.footer-credentials .creds {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.footer-credentials .creds span {
  background: rgba(255,255,255,0.05);
  padding: 4px 10px;
  border-radius: 4px;
  font-family: 'Inter', monospace;
}

@media (max-width: 1024px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 640px) { .footer-grid { grid-template-columns: 1fr; gap: 24px; } }

/* ── RESPONSIVE NAV ── */
@media (max-width: 900px) {
  .nav .container { height: auto; padding: 12px 24px; flex-wrap: wrap; }
  .nav .links { display: none; width: 100%; flex-direction: column; padding-top: 12px; border-top: 1px solid var(--pa-border); margin-top: 12px; }
  .nav .links.open { display: flex; }
  .nav .links a { padding: 12px 14px; }
}

